process {
    // Requests sized from the peak memory and CPU use recorded in complete runs (WGS 30x, with
    // headroom for 90x) and from the tools' threading. Memory and time grow with the attempt (a job
    // killed for memory or time is retried with twice the request); CPUs do not.
    cpus   = { check_max( 2     * task.attempt, 'cpus'   ) }
    memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    time   = { check_max( 4.h   * task.attempt, 'time'   ) }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 5
    maxErrors     = '-1'

    // Java settings inherited from the submitting shell (_JAVA_OPTIONS, JAVA_TOOL_OPTIONS) take
    // precedence over the -Xmx and GC flags every Java step sets; drop them before each task.
    beforeScript = 'unset _JAVA_OPTIONS JAVA_TOOL_OPTIONS'

    withLabel:process_low {
        cpus   = { check_max( 2     * task.attempt, 'cpus'    ) }
        memory = { check_max( 16.GB * task.attempt, 'memory'  ) }
        time   = { check_max( 4.h   * task.attempt, 'time'    ) }
    }
    withLabel:process_medium {                // SAGE (22 GB at 30x), ASCAT, Manta, mosdepth
        cpus   = { check_max( 8     * task.attempt, 'cpus'    ) }
        memory = { check_max( 64.GB * task.attempt, 'memory'  ) }
        time   = { check_max( 8.h   * task.attempt, 'time'    ) }
    }
    withLabel:process_high {                  // CNVkit (29 GB at 30x)
        cpus   = { check_max( 16    * task.attempt, 'cpus'    ) }
        memory = { check_max( 64.GB * task.attempt, 'memory'  ) }
        time   = { check_max( 16.h  * task.attempt, 'time'    ) }
    }
    withLabel:process_long {
        time   = { check_max( 20.h  * task.attempt, 'time'    ) }
    }
    withLabel:process_high_memory {
        memory = { check_max( 200.GB * task.attempt, 'memory' ) }
    }
    withLabel: FASTQC {                       // two FASTQ files, one thread each; 1.5 GB
        cpus   = { check_max( 2, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 30.h * task.attempt, 'time' ) }
    }
    withLabel: BWA_MEM {                      // bwa-mem2 + samtools sort; 29 GB, coverage-independent
        cpus   = { check_max( 16, 'cpus' ) }
        memory = { check_max( 64.GB * task.attempt, 'memory' ) }
        time   = { check_max( 30.h * task.attempt, 'time' ) }
    }
    withLabel:MKDUP {                         // Picard MarkDuplicates, single-threaded; 18 GB at 30x
        cpus   = { check_max( 2, 'cpus' ) }
        memory = { check_max( 48.GB * task.attempt, 'memory' ) }
        time   = { check_max( 20.h * task.attempt, 'time' ) }
    }
    withLabel:RECALIBRATE {                   // BaseRecalibrator / ApplyBQSR / GatherBQSRReports, single-threaded; < 2 GB
        cpus   = { check_max( 2, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 8.h * task.attempt, 'time' ) }
    }
    withLabel:RECALIBRATE_MergeBam {          // samtools merge + index of the 20 ApplyBQSR chunks
        cpus   = { check_max( 8, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 10.h * task.attempt, 'time' ) }
    }
    withLabel:MUTECT2_CALLING {               // 4 GB at 30x, 8 GB in a 90x Sarek run
        cpus   = { check_max( 2, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 8.h * task.attempt, 'time' ) }
    }
    withLabel:GETpileUP {                     // GetPileupSummaries, single-threaded; 4 GB
        cpus   = { check_max( 1, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h * task.attempt, 'time' ) }
    }
    withLabel:MuSE {                          // 36 GB at 30x with 16 threads
        cpus   = { check_max( 16, 'cpus' ) }
        memory = { check_max( 64.GB * task.attempt, 'memory' ) }
        time   = { check_max( 12.h * task.attempt, 'time' ) }
    }
    withLabel:STRELKA {                       // 1.4 GB at 30x
        cpus   = { check_max( 8, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 12.h * task.attempt, 'time' ) }
    }
    withName: CONPAIR {                       // GATK3 pileups, single-threaded; 4 GB
        cpus   = { check_max( 2, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
    }
    withName: MOSDEPTH {                      // 4 threads used of 8; 2 GB
        cpus   = { check_max( 4, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
    }
    withName: CNVkit_buildcnn {               // 4 threads used of 16; 8 GB; 2.7 h at 30x
        cpus   = { check_max( 8, 'cpus' ) }
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
    }
    withName: 'Delly_SVcalling|Delly_Filtering' {   // 1.7 h and 2.7 h at 30x, single-threaded
        time   = { check_max( 12.h * task.attempt, 'time' ) }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}
