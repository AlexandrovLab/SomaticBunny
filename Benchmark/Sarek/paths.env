DATABASE_PATH=/path/to/reference/Databases
TMPDIR=/path/to/scratch/tmp

DBSNP_VCF=${DATABASE_PATH}/GRCh38/resources_broad_hg38_v0_Homo_sapiens_assembly38.dbsnp138.vcf.gz
DBSNP_TBI=${DBSNP_VCF}.tbi

KNOWN_INDELS=${DATABASE_PATH}/GRCh38/Homo_sapiens_assembly38.known_indels.vcf.gz
KNOWN_INDELS_TBI=${KNOWN_INDELS}.tbi

PON_VCF=${DATABASE_PATH}/GRCh38/PON.sorted.vcf.gz
PON_TBI=${PON_VCF}.tbi

GERMLINE_RESOURCE=${DATABASE_PATH}/GRCh38/af-only-gnomad.hg38.vcf.gz
# Only passed in the WES run (the WGS runs did not pass --germline_resource_tbi)
GERMLINE_RESOURCE_TBI=${GERMLINE_RESOURCE}.tbi

# WGS intervals (see intervals/make_wgs_intervals.sh; SCRIPT_DIR is this folder)
INTERVALS=${SCRIPT_DIR}/intervals/wgs_20intervals.sorted.bed
# WES intervals
WES_INTERVALS=${DATABASE_PATH}/GRCh38/GRCh38_exome_merged.bed
