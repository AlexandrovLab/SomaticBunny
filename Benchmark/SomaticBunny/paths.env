# Reference/database locations for the SomaticBunny benchmark runs.
# Benchmark values (TSCC): DATABASE_PATH=/tscc/projects/ps-lalexandrov/shared/SomaticBunny
#                          TMPDIR=/tscc/lustre/restricted/alexandrov-ddn/users/<user>/<run>  (per-run, e.g. .../30x)
DATABASE_PATH=/path/to/SomaticBunny_database 
TMPDIR=/path/to/scratch/tmp

# Reference genome (GRCh38.d1.vd1)
REF=${DATABASE_PATH}/GRCh38_ref/GRCh38.d1.vd1.fa
REF_FAI=${REF}.fai
REF_DICT=${DATABASE_PATH}/GRCh38_ref/GRCh38.d1.vd1.dict

# WGS genome BED (whole chromosomes)
BED=${DATABASE_PATH}/GRCh38_ref/hg38_chr.bed.gz
BED_TBI=${BED}.tbi

# WES capture targets, applied at the consensus step (--callable_bed); the same BED Sarek used as --intervals
WES_CALLABLE_BED=${DATABASE_PATH}/Databases/GRCh38/GRCh38_exome_merged.bed
